import fnc type_first_case from "./type-first.ores";
import fnc name_first_case from "./name-first.ores";
import fnc lambda_order_case from "./lambda-order.ores";

fnc assert_eq_int(String label, int actual, int expected): void {
  if actual != expected then
    stdio.stdout.write("PARITY_FAIL|parameter-syntax|");
    stdio.stdout.write(label);
    stdio.stdout.write("|actual=");
    stdio.stdout.write(actual);
    stdio.stdout.write("|expected=");
    stdio.stdout.println(expected);
    val Result<bool, String> failure = Err(label);
    failure.expect("cross-compiler parity assertion failed");
  fi
  return;
}

fnc parity_ok(int checksum): void {
  stdio.stdout.write("PARITY_OK|parameter-syntax|");
  stdio.stdout.println(checksum);
  return;
}

pub fnc main(): void {
  assert_eq_int("type-first", type_first_case(4, 2), 42);
  assert_eq_int("name-first", name_first_case(4, 2), 42);
  assert_eq_int("lambda-mixed", lambda_order_case(), 42);
  parity_ok(126);
  return;
}
