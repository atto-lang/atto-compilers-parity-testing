// Canonical public counter actor: all mutable state changes use handle_state.
define pub actor Counter as
  state {
    count: int = 0;
  }

  receive(ActorMail<int> mail): void {
    const next = self.handle_state(critical |s| -> {
      s.count = s.count + mail.value;
      return s.count;
    });
    self.send(next);
    self.end();
    return;
  }
end
