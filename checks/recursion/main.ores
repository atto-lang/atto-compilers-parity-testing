import fnc factorial from "./factorial.ores";
import fnc fibonacci from "./fibonacci.ores";
import fnc is_even from "./even.ores";

fnc assert_eq_int(String label, int actual, int expected): void {
  if actual != expected then
    stdio.stdout.write("PARITY_FAIL|recursion|");
    stdio.stdout.write(label);
    stdio.stdout.write("|actual=");
    stdio.stdout.write(actual);
    stdio.stdout.write("|expected=");
    stdio.stdout.println(expected);
    val Result<bool, String> failure = Err(label);
    failure.expect("cross-compiler parity assertion failed");
  fi
  return;
}

fnc parity_ok(int checksum): void {
  stdio.stdout.write("PARITY_OK|recursion|");
  stdio.stdout.println(checksum);
  return;
}

pub fnc main(): void {
  assert_eq_int("factorial", factorial(5), 120);
  assert_eq_int("fibonacci", fibonacci(10), 55);
  assert_eq_int("mutual", is_even(42), 1);
  parity_ok(176);
  return;
}
