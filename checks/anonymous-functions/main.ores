import fnc pipe_lambda_case from "./pipe.ores";
import fnc typed_lambda_case from "./typed.ores";
import fnc capture_lambda_case from "./capture.ores";

fnc assert_eq_int(String label, int actual, int expected): void {
  if actual != expected then
    stdio.stdout.write("PARITY_FAIL|anonymous-functions|");
    stdio.stdout.write(label);
    stdio.stdout.write("|actual=");
    stdio.stdout.write(actual);
    stdio.stdout.write("|expected=");
    stdio.stdout.println(expected);
    val Result<bool, String> failure = Err(label);
    failure.expect("cross-compiler parity assertion failed");
  fi
  return;
}

fnc parity_ok(int checksum): void {
  stdio.stdout.write("PARITY_OK|anonymous-functions|");
  stdio.stdout.println(checksum);
  return;
}

pub fnc main(): void {
  assert_eq_int("pipe", pipe_lambda_case(), 42);
  assert_eq_int("typed", typed_lambda_case(), 42);
  assert_eq_int("capture", capture_lambda_case(), 42);
  parity_ok(126);
  return;
}
