// 40: GLM/MoE shared-source parity candidate. No backend-specific rewriting.
// Return 42 on correct semantic behavior, 1 on mismatch. Compiler-backed evidence pending.
fnc admitted(int load0, int load1, int cap): bool { if (load0 < 0 || load1 < 0) { return false; } fi return load0 <= cap && load1 <= cap; }
pub fnc main(): int { if (admitted(-1, 2, 2)) { return 1; } fi return 42; }
