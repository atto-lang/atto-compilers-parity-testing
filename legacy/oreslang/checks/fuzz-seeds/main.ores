import fnc sequence_checksum from "./generator.ores";
import fnc affine_identity from "./metamorphic.ores";
import fnc seed_oracle from "./oracle.ores";

fnc assert_eq_int(String label, int actual, int expected): void {
  if actual != expected then
    stdio.stdout.write("PARITY_FAIL|fuzz-seeds|");
    stdio.stdout.write(label);
    stdio.stdout.write("|actual=");
    stdio.stdout.write(actual);
    stdio.stdout.write("|expected=");
    stdio.stdout.println(expected);
    val Result<bool, String> failure = Err(label);
    failure.expect("cross-compiler parity assertion failed");
  fi
  return;
}

fnc parity_ok(int checksum): void {
  stdio.stdout.write("PARITY_OK|fuzz-seeds|");
  stdio.stdout.println(checksum);
  return;
}

pub fnc main(): void {
  assert_eq_int("seed-1", sequence_checksum(1, 8), seed_oracle(1));
  assert_eq_int("seed-7", sequence_checksum(7, 8), seed_oracle(7));
  assert_eq_int("seed-42", sequence_checksum(42, 8), seed_oracle(42));
  assert_eq_int("metamorphic", affine_identity(1234), 1);
  parity_ok(sequence_checksum(1, 8) + sequence_checksum(7, 8) + sequence_checksum(42, 8));
  return;
}
