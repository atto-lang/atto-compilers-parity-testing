import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, run_suite, require_success, fail from "ores.std/testing";
fnc checked_result_fallback_is_explicit(): TestOutcome {
  val Result<int, String> rejected = Err("negative");
  val Result<int, String> accepted = Ok(41);
  return expect_true(Result.unwrap_or(rejected, 12) == 12
    && Result.unwrap_or(accepted, 12) == 41,
    "Result fallback must preserve Ok and replace Err without implicit coercion");
}
fnc option_fallback_is_explicit(): TestOutcome {
  val Option<int> valid = Some(9);
  val Option<int> missing = None;
  return expect_true(Option.unwrap_or(valid, -1) == 9 &&
    Option.unwrap_or(missing, -1) == -1,
    "portable Option fallback must distinguish present and absent values");
}
fnc result_is_error_without_implicit_unwrap(): TestOutcome {
  val Result<int, String> rejected = Err("denied");
  return expect_true(rejected.is_err(),
    "error Result retains explicit error state");
}

fnc some_zero_is_not_none(): TestOutcome {
  val Option<int> zero = Some(0);
  return expect_true(zero.is_some() && Option.unwrap_or(zero, 7) == 0,
    "present zero value must not be treated as None");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("cross-compiler-parity", arr[
    new TestCase("checked_result_fallback_is_explicit", checked_result_fallback_is_explicit, false, ""),
    new TestCase("option_fallback_is_explicit", option_fallback_is_explicit, false, ""),
    new TestCase("result_is_error_without_implicit_unwrap", result_is_error_without_implicit_unwrap, false, ""),
    new TestCase("some_zero_is_not_none", some_zero_is_not_none, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
